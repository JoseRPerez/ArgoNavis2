<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/app-auto"
    xmlns:app2="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondoTopBar"
    android:elevation="@dimen/text_1_second_row"
    android:orientation="vertical"
    android:padding="15dp"
    tools:ignore="ResAuto">

    <!-- Header fijo (no hace scroll) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="Nueva Observación"
            android:textColor="@color/main"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_save"
            style="@style/iconos_dorados"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ok"
            tools:ignore="SpeakableTextPresentCheck" />
    </LinearLayout>

    <!-- ScrollView expandido con layout_weight="1" -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RatingBar
                android:id="@+id/RateBarMap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:alpha="0.75"
                android:hapticFeedbackEnabled="false"
                android:numStars="5"
                android:progressBackgroundTint="@color/gris1"
                android:progressTint="@color/main"
                android:rating="1"
                android:scaleX=".7"
                android:scaleY=".7"
                android:stepSize="1"
                tools:ignore="ObsoleteLayoutParam,RtlHardcoded" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Lugar de Observación:"
                android:textColor="@color/main"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/AC_lugar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/main"
                    android:minHeight="48dp"
                    android:textColor="@color/gris3"
                    android:textSize="20sp"
                    tools:ignore="LabelFor,SpeakableTextPresentCheck" />

                <ImageButton
                    android:id="@+id/btn_place"
                    style="@style/iconos_dorados"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app2:srcCompat="@drawable/location"
                    tools:ignore="SpeakableTextPresentCheck" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Telescopio:"
                android:textColor="@color/main"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/AC_telescopio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/main"
                    android:minHeight="48dp"
                    android:textColor="@color/gris3"
                    android:textSize="20sp"
                    tools:ignore="LabelFor,SpeakableTextPresentCheck" />

                <ImageButton
                    android:id="@+id/btn_telescope"
                    style="@style/iconos_dorados"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app2:srcCompat="@drawable/telescope"
                    tools:ignore="SpeakableTextPresentCheck" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Ocular:"
                android:textColor="@color/main"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/AC_ocular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/main"
                    android:minHeight="48dp"
                    android:textColor="@color/gris3"
                    android:textSize="20sp"
                    tools:ignore="LabelFor,SpeakableTextPresentCheck" />

                <ImageButton
                    android:id="@+id/btn_ocular"
                    style="@style/iconos_dorados"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app2:srcCompat="@drawable/ocular"
                    tools:ignore="SpeakableTextPresentCheck" />
            </LinearLayout>

            <EditText
                android:id="@+id/memory_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/gris3"
                android:ems="10"
                android:hint="Escribe aquí un nuevo registro"
                android:inputType="text|textAutoComplete|textAutoCorrect|textCapSentences|textMultiLine"
                android:minHeight="48dp"
                android:textColor="@color/gris4"
                android:textColorHint="@color/gris3"
                android:textSize="20sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>