<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".SettingChartActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fondo_lista"
        android:orientation="vertical"
        tools:ignore="UselessParent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/mainTopBar"
            android:elevation="4dp"
            android:minHeight="?attr/actionBarSize"
            android:theme="?attr/actionBarTheme">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Botón a la izquierda -->
                <ImageButton
                    android:id="@+id/ibback"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#00FFFFFF"
                    android:contentDescription="@string/menu"
                    android:padding="8dp"
                    android:src="@drawable/arrow_left"
                    android:visibility="visible"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/gris4"
                    tools:ignore="TouchTargetSizeCheck" />

                <!-- Título centrado -->
                <TextView
                    android:id="@+id/toolbarTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="16dp"
                    android:text="Edición de Cartas"
                    android:textColor="@color/gris4"
                    android:textSize="18sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ibback"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Botón a la derecha -->

                <ImageButton
                    android:id="@+id/ibsave"
                    style="@style/iconos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/mostrar_ocultar_constelaciones"
                    android:padding="8dp"
                    android:src="@drawable/save"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/main"
                    tools:ignore="TouchTargetSizeCheck" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.appcompat.widget.Toolbar>


        <TextView
            android:id="@+id/textView2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:text="Seleccionar Carta y Establecer Vecinos. Puede establecer varios separados por comas"
            android:textColor="@color/gris3"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.gridlayout.widget.GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:padding="8dp"
            android:visibility="visible"
            app:columnCount="3"
            app:columnOrderPreserved="false"
            app:rowCount="3">

            <!-- Fila 1 - Celda central (Arriba) -->
            <EditText
                android:id="@+id/up"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_margin="8dp"
                android:background="@drawable/border_textvew"
                android:gravity="center"
                android:hint="Arriba"
                android:inputType="text|textNoSuggestions"
                android:importantForAutofill="no"
                android:textColor="@color/main"
                android:textColorHint="@color/main"
                android:textSize="18sp"
                app:layout_column="1"
                app:layout_columnWeight="1"
                app:layout_row="0"
                app:layout_rowWeight="1" />

            <!-- Fila 2 - Celda izquierda -->
            <EditText
                android:id="@+id/left"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_margin="8dp"
                android:background="@drawable/border_textvew"
                android:gravity="center"
                android:hint="Izquierda"
                android:inputType="text|textNoSuggestions"
                android:importantForAutofill="no"
                android:textColor="@color/main"
                android:textColorHint="@color/main"
                app:layout_column="0"
                app:layout_columnWeight="1"
                app:layout_row="1"
                app:layout_rowWeight="1" />

            <!-- Fila 2 - Celda central (Spinner) -->
            <Spinner
                android:id="@+id/chartSpinner"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="8dp"
                android:background="@drawable/border_textvew2"
                app:layout_column="1"
                app:layout_columnWeight="1"
                app:layout_row="1"
                app:layout_rowWeight="1" />

            <!-- Fila 2 - Celda derecha -->
            <EditText
                android:id="@+id/right"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_margin="8dp"
                android:background="@drawable/border_textvew"
                android:gravity="center"
                android:hint="Derecha"
                android:inputType="text|textNoSuggestions"
                android:importantForAutofill="no"
                android:textColor="@color/main"
                android:textColorHint="@color/main"
                app:layout_column="2"
                app:layout_columnWeight="1"
                app:layout_row="1"
                app:layout_rowWeight="1" />

            <!-- Fila 3 - Celda central (Abajo) -->
            <EditText
                android:id="@+id/down"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_margin="8dp"
                android:background="@drawable/border_textvew"
                android:gravity="center"
                android:hint="Abajo"
                android:inputType="text|textNoSuggestions"
                android:importantForAutofill="no"
                android:textColor="@color/main"
                android:textColorHint="@color/main"
                app:layout_column="1"
                app:layout_columnWeight="1"
                app:layout_row="2"
                app:layout_rowWeight="1" />
        </androidx.gridlayout.widget.GridLayout>

        <!-- Mitad inferior: Inputs para coordenadas -->

        <TextView
            android:id="@+id/textView5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="15dp"
            android:text="Establecer Límites de la Carta"
            android:textColor="@color/gris3"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.gridlayout.widget.GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_weight="1"
            android:padding="8dp"
            app:columnCount="2"
            app:rowCount="4">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AR Min:"
                android:textColor="@color/gris3"
                android:textSize="18dp"
                app:layout_column="0"
                app:layout_columnWeight="3"
                app:layout_row="0" />

            <EditText
                android:id="@+id/minAR"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/border_textvew"
                android:hint="Ascensión Recta Mínima"
                android:inputType="number|numberDecimal|numberSigned"
                android:minHeight="48dp"
                android:paddingStart="5dp"
                android:textColor="@color/main"
                android:textColorHint="@color/main"
                app:layout_column="1"
                app:layout_columnWeight="7"
                app:layout_row="0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AR Max:"
                android:textColor="@color/gris3"
                android:textSize="18dp"
                app:layout_column="0"
                app:layout_columnWeight="3"
                app:layout_row="1" />

            <EditText
                android:id="@+id/maxAR"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/border_textvew"
                android:hint="Ascensión Recta Máxima"
                android:inputType="number|numberDecimal|numberSigned"
                android:minHeight="48dp"
                android:paddingStart="5dp"
                android:textColor="@color/main"
                android:textColorHint="@color/main"
                app:layout_column="1"
                app:layout_columnWeight="7"
                app:layout_row="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dec Min:"
                android:textColor="@color/gris3"
                android:textSize="18dp"
                app:layout_column="0"
                app:layout_columnWeight="3"
                app:layout_row="2" />

            <EditText
                android:id="@+id/minDEC"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/border_textvew"
                android:hint="Declinación Mínima"
                android:inputType="number|numberDecimal|numberSigned"
                android:minHeight="48dp"
                android:paddingStart="5dp"
                android:textColor="@color/main"
                android:textColorHint="@color/main"
                app:layout_column="1"
                app:layout_columnWeight="7"
                app:layout_row="2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dec Max:"
                android:textColor="@color/gris3"
                android:textSize="18dp"
                app:layout_column="0"
                app:layout_columnWeight="3"
                app:layout_row="3" />

            <EditText
                android:id="@+id/maxDEC"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/border_textvew"
                android:hint="Declinación Máxima"
                android:inputType="number|numberDecimal|numberSigned"
                android:minHeight="48dp"
                android:paddingStart="5dp"
                android:textColor="@color/main"
                android:textColorHint="@color/main"
                app:layout_column="1"
                app:layout_columnWeight="7"
                app:layout_row="3" />

        </androidx.gridlayout.widget.GridLayout>

    </LinearLayout>
</LinearLayout>