<?xml version="1.0" encoding="utf-8"?>
<com.chauthai.swipereveallayout.SwipeRevealLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipelayout"
    style="@style/fondo"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    app:dragEdge="right"
    app:mode="same_level">

    <!---Swipe Layout-->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/ibOut"
            android:layout_width="100dp"
            android:layout_height="70dp"
            android:layout_weight="1"
            android:backgroundTint="@color/granate"
            android:src="@drawable/remove_from_list"
            app:tint="@color/blanco" />

    </LinearLayout>

    <!---Main Layout-->


    <RelativeLayout
        android:id="@+id/RL"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_card_single_2">


        <ImageButton
            android:id="@+id/iv_dso"
            style="@style/iconos"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="5dp"
            android:cropToPadding="false"
            android:scaleX="0.8"
            android:scaleY="0.8"
            android:src="@drawable/galaxy" />


        <TextView
            android:id="@+id/TV_lista_CAT"
            style="@style/text_second_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="false"
            android:layout_alignParentTop="true"
            android:layout_marginTop="10dp"
            android:layout_toRightOf="@id/iv_dso"
            android:text="CAT+ref"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/TV_lista_Name"
            style="@style/text_second_list_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/TV_lista_CAT"
            android:layout_alignStart="@id/TV_lista_CAT"
            android:layout_alignParentStart="false"
            android:layout_marginBottom="10dp"
            android:layout_toLeftOf="@id/TV_ToView"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:text="NAME"
            android:textStyle="bold"
            tools:ignore="HardcodedText,RtlHardcoded" />

        <TextView
            android:id="@+id/TV_ToView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/TV_lista_Name"
            android:layout_marginRight="10dp"
            android:layout_toStartOf="@+id/TV_YaVisto"
            android:paddingLeft="10dp"
            android:text="●"
            android:textColor="@color/granate2"
            android:textSize="20sp"
            tools:ignore="HardcodedText,RtlHardcoded" />

        <TextView
            android:id="@+id/TV_YaVisto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/TV_lista_Name"
            android:layout_alignParentEnd="true"
            android:layout_marginLeft="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginRight="10dp"
            android:text="●"
            android:textColor="@android:color/holo_blue_dark"
            android:textSize="20sp"
            android:visibility="visible"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/TV_rate"
            style="@style/texto_datos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@id/TV_lista_CAT"
            android:layout_marginEnd="3dp"
            android:layout_toLeftOf="@id/imageView"
            android:gravity="center_vertical"
            android:text="3"
            android:textColor="@color/gris3"
            android:textSize="18sp"
            android:visibility="visible"
            tools:ignore="HardcodedText,RtlHardcoded" />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_alignTop="@id/TV_rate"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="false"
            android:layout_marginEnd="5dp"
            android:visibility="visible"
            app:srcCompat="@android:drawable/btn_star_big_off"
            app:tint="@color/Naranja" />

    </RelativeLayout>

</com.chauthai.swipereveallayout.SwipeRevealLayout>