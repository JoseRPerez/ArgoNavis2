<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/negro"
    android:focusableInTouchMode="true"
    android:orientation="vertical">


    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/mainTopBar"
        android:elevation="4dp"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        android:visibility="visible"
        app:popupTheme="@style/MiTemaPopUp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Botón a la izquierda -->
            <ImageButton
                android:id="@+id/ibBack"
                style="@style/iconos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#00000000"
                android:contentDescription="@string/menu"
                android:padding="8dp"
                android:src="@drawable/arrow_left"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="TouchTargetSizeCheck" />

            <!-- Título centrado -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="16dp"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:text="M 34"
                android:textColor="@color/mainTitleTopBar"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ibBack"
                app:layout_constraintTop_toTopOf="parent" />


            <!-- Botón a la derecha -->

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.Toolbar>


    <androidx.core.widget.NestedScrollView
        android:id="@+id/SV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/fondo_lista"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:id="@+id/foto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="16dp"
                android:visibility="visible"
                app:cardBackgroundColor="@color/carViewBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/main2"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="5dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/ll_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/name"
                            style="@style/title_card"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:layout_weight="1"
                            android:text="Imagen"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/ib_expand_foto"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginRight="10dp"
                            android:background="#00FFFFFF"
                            app:srcCompat="@drawable/expand"
                            app:tint="@color/gris3"
                            tools:ignore="TouchTargetSizeCheck" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/IV_foto"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_weight="0.74"
                        android:clickable="true"
                        android:forceDarkAllowed="false"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        app:srcCompat="@drawable/imagen"
                        tools:ignore="ContentDescription,InefficientWeight,SpeakableTextPresentCheck" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <RatingBar
                    android:id="@+id/RateBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.75"
                    android:hapticFeedbackEnabled="false"
                    android:numStars="5"
                    android:progressBackgroundTint="@color/gris1"
                    android:progressTint="@color/main"
                    android:rating="2"
                    android:scaleX=".7"
                    android:scaleY=".7"
                    android:stepSize="1"
                    tools:ignore="ObsoleteLayoutParam,RtlHardcoded" />

                <ImageButton
                    android:id="@+id/vistoBtn"
                    style="@style/iconos"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:onClick="toggleVisto"
                    android:tint="@color/azul"
                    app:srcCompat="@drawable/eye"
                    tools:ignore="SpeakableTextPresentCheck,UseAppTint" />

                <ImageButton
                    android:id="@+id/toviewBtn"
                    style="@style/iconos"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:onClick="togglePendiente"
                    android:tint="@color/granate"
                    app:srcCompat="@drawable/eye"
                    tools:ignore="SpeakableTextPresentCheck,UseAppTint" />

            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardGralInfo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="16dp"
                android:visibility="visible"
                app:cardBackgroundColor="@color/carViewBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="5dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textView4"
                            style="@style/title_card"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:layout_weight="1"
                            android:text="Información General"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/ib_expand_gral_info"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginRight="10dp"
                            android:background="#00FFFFFF"
                            app:srcCompat="@drawable/expand"
                            app:tint="@color/gris3" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/LLgral_info"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="15dp"
                        android:layout_marginBottom="10dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/TV_Desig"
                            style="@style/text_card"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginBottom="4dp"
                            android:text="Designación: NGC 224"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:id="@+id/TV_Tipo"
                            style="@style/text_card"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginBottom="4dp"
                            android:text="Tipo: Cúmulo Abierto"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:id="@+id/TV_Constelacion"
                            style="@style/text_card"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginBottom="4dp"
                            android:text="Constelación: Andrómeda"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:id="@+id/TV_Size"
                            style="@style/text_card"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginBottom="4dp"
                            android:text="Tamaño aparente: 22&quot;"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginBottom="4dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/TV_Magnitud"
                                style="@style/text_card"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_gravity="center_vertical"
                                android:layout_weight="1"
                                android:text="Magnitud: 10.6"
                                android:textStyle="bold"
                                tools:ignore="HardcodedText" />

                            <ImageButton
                                android:id="@+id/ib_avvso"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginRight="10dp"
                                android:background="#00FFFFFF"
                                android:onClick="getMagFromAVVSO"
                                android:visibility="visible"
                                app:srcCompat="@drawable/info"
                                app:tint="@color/gris3" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/TV_AR"
                            style="@style/text_card"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginBottom="4dp"
                            android:text="AR: 22.75"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:id="@+id/TV_DEC"
                            style="@style/text_card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="DEC: -15.2"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                    </LinearLayout>
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="16dp"
                app:cardBackgroundColor="@color/carViewBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="5dp"
                    android:onClick="editCarta"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textView14"
                            style="@style/title_card"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:layout_weight="1"
                            android:text="Cartas"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                        <ImageButton
                            android:id="@+id/IB_DownChart"
                            style="@style/iconos_bar"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginRight="5dp"
                            android:onClick="downloadChartFromAVVSO"
                            android:src="@drawable/download"
                            android:visibility="visible"
                            app:tint="@color/gris3"
                            tools:ignore="SpeakableTextPresentCheck" />

                        <ImageButton
                            android:id="@+id/IB_deepSearch"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="bottom"
                            android:layout_marginRight="10dp"
                            android:backgroundTint="@color/Transparente"
                            android:src="@drawable/deep_search"
                            android:tint="@color/main"
                            tools:ignore="UseAppTint,SpeakableTextPresentCheck" />


                        <ImageButton
                            android:id="@+id/IB_editCarta"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginRight="10dp"
                            android:background="#00000000"
                            android:onClick="editCarta"
                            android:src="@drawable/lock"
                            app:tint="@color/gris3"
                            tools:ignore="SpeakableTextPresentCheck" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:onClick="editCarta"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/TV_carta"
                            style="@style/text_map_card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginRight="10dp"
                            android:layout_marginBottom="10dp"
                            android:layout_weight="1"
                            android:background="#00FFFFFF"
                            android:text="3,72"
                            tools:ignore="HardcodedText" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardInfo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="16dp"
                app:cardBackgroundColor="@color/carViewBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="5dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textView16"
                            style="@style/title_card"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_margin="5dp"
                            android:layout_weight="10"
                            android:text="Información"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                        <ImageButton
                            android:id="@+id/IB_editInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#00FFFFFF"
                            android:onClick="editInfo"
                            android:padding="2dp"
                            android:src="@drawable/lock"
                            android:visibility="gone"
                            app:tint="@color/gris3"
                            tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

                        <ImageButton
                            android:id="@+id/ib_expand_info"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginRight="10dp"
                            android:background="#00FFFFFF"
                            app:srcCompat="@drawable/expand"
                            app:tint="@color/gris3" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/TV_info"
                        style="@style/text_card"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:layout_marginBottom="10dp"
                        android:inputType="text|textAutoComplete|textAutoCorrect|textCapSentences|textMultiLine"
                        android:text="asdfasf\nasdfasfsa\kdjfd"
                        android:visibility="gone"
                        tools:ignore="HardcodedText" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="20dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView17"
                    style="@style/title_card"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginRight="20dp"
                    android:layout_weight="10"
                    android:text="Objetos Cercanos"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <ImageButton
                    android:id="@+id/IB_refresh"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#00FFFFFF"
                    android:src="@drawable/refresh"
                    app:tint="@color/gris3" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/RV_random"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="5dp"
                android:layout_marginBottom="10dp"
                android:nestedScrollingEnabled="false"
                android:visibility="visible" />


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>