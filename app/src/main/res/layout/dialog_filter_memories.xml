<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentEnd="true"
    android:layout_margin="0dp"
    android:background="@drawable/border_textview_gris">

    <TextView
        android:id="@+id/tv1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="20dp"
        android:text="Filtrar Memorias"
        android:textColor="@color/gris4"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:ignore="HardcodedText,RtlHardcoded" />

    <ImageButton
        android:id="@+id/Btn_add"
        style="@style/iconos_dorados"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_margin="10dp"
        android:layout_marginRight="10dp"
        app:srcCompat="@drawable/ok"
        tools:ignore="SpeakableTextPresentCheck" />

    <Spinner
        android:id="@+id/sp_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/Btn_add"
        android:layout_alignStart="@+id/tv1"
        android:layout_marginTop="18dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="@color/colorSelected"
        android:minHeight="48dp" />

    <Spinner
        android:id="@+id/sp_secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/sp_main"
        android:layout_alignStart="@+id/tv1"
        android:layout_marginTop="18dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="38dp"
        android:backgroundTint="@color/colorSelected"
        android:minHeight="48dp" />

    <Button
        android:id="@+id/exportMemories"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/sp_secondary"
        android:layout_alignParentRight="true"
        android:layout_marginRight="18sp"
        android:layout_marginBottom="18sp"
        android:background="@drawable/border_textvew"
        android:foregroundTintMode="add"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:text="Exportar todo"
        android:textColor="@color/main" />


</RelativeLayout>