<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#5D4223" /> <!-- Color del borde -->
            <corners android:topLeftRadius="12dp" android:topRightRadius="12dp" />
        </shape>
    </item>
    <!-- Oculta la línea inferior recortando 1dp de abajo -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#000000" /> <!-- Color de fondo interior -->
            <corners android:topLeftRadius="11dp" android:topRightRadius="11dp" />
        </shape>
    </item>
</layer-list>