<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#5D4223" />
            <corners android:bottomLeftRadius="12dp" android:bottomRightRadius="12dp" />
        </shape>
    </item>
    <!-- Oculta la línea superior recortando 1dp de arriba -->
    <item android:top="0dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#000000" />
            <corners android:bottomLeftRadius="11dp" android:bottomRightRadius="11dp" />
        </shape>
    </item>
</layer-list>