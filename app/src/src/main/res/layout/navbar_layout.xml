<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/negro"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/negro"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/IB_Back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/negro"
            android:onClick="back"
            android:tint="@color/granate"
            app:srcCompat="@drawable/icono_back"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/textView28"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:gravity="center"
            android:text="Opciones"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText,InefficientWeight" />

        <ImageButton
            android:id="@+id/imageButton8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/negro"
            android:tint="@color/granate"
            android:visibility="invisible"
            app:srcCompat="@drawable/icono_back"
            tools:ignore="ContentDescription" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:layout_marginTop="20dp"
        android:background="@color/negro"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/IB_backup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/Transparencia"
                android:onClick="CreateBackup"
                app:srcCompat="@mipmap/backup_foreground" />

            <ImageButton
                android:id="@+id/IB_Index"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/Transparencia"
                android:onClick="OpenIndices"
                app:srcCompat="@mipmap/starindex_foreground" />

            <ImageButton
                android:id="@+id/IB_NewObject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/Transparencia"
                android:contentDescription="TODO"
                android:onClick="NewItem"
                app:srcCompat="@mipmap/newobject_foreground" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/LinearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/TV_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:onClick="CreateBackup"
                android:text="Realizar\nBackup"
                android:textAlignment="center"
                android:textColor="@color/granate"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/TV_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:onClick="OpenIndices"
                android:text="Consultar\nÍndices"
                android:textAlignment="center"
                android:textColor="@color/granate"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/TV_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:onClick="NewItem"
                android:text="Nuevo\nobjeto"
                android:textAlignment="center"
                android:textColor="@color/granate"
                android:textSize="20sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/IB_NL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/Transparencia"
                android:onClick="NewUserList"
                app:srcCompat="@mipmap/newlist_foreground" />

            <ImageButton
                android:id="@+id/ib_null"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/Transparencia"
                android:onClick="DelUserList"
                app:srcCompat="@mipmap/removelist_foreground" />

            <ImageButton
                android:id="@+id/ib_null2"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/Transparencia"
                android:onClick="openDialogChartConstellation"
                app:srcCompat="@mipmap/setcharts_foreground" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-20dp"
            android:orientation="horizontal"
            android:visibility="visible"
            tools:visibility="visible">

            <TextView
                android:id="@+id/TV_7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:onClick="NewUserList"
                android:text="Nueva\nLista"
                android:textAlignment="center"
                android:textColor="@color/granate"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/TV_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:onClick="DelUserList"
                android:text="Eliminar\nLista"
                android:textAlignment="center"
                android:textColor="@color/granate"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/TV_9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:onClick="openDialogChartConstellation"
                android:text="Asignar Cartas"
                android:textAlignment="center"
                android:textColor="@color/granate"
                android:textSize="20sp"
                tools:visibility="visible" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/IB_calc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/negro"
                android:onClick="Recalcular"
                app:srcCompat="@mipmap/ic_calc_foreground" />

            <ImageButton
                android:id="@+id/ib_other"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/Transparencia"
                android:visibility="invisible"
                app:srcCompat="@mipmap/removelist_foreground" />

            <ImageButton
                android:id="@+id/ib_other2"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/Transparencia"
                android:visibility="invisible"
                app:srcCompat="@mipmap/setcharts_foreground" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-20dp"
            android:orientation="horizontal"
            android:visibility="visible"
            tools:visibility="visible">

            <TextView
                android:id="@+id/TV_7_"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:onClick="Recalcular"
                android:text="Recalcular"
                android:textAlignment="center"
                android:textColor="@color/granate"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/TV_8_"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Eliminar\nLista"
                android:textAlignment="center"
                android:textColor="@color/granate"
                android:textSize="20sp"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/TV_9_"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Asignar Cartas"
                android:textAlignment="center"
                android:textColor="@color/granate"
                android:textSize="20sp"
                android:visibility="invisible" />

        </LinearLayout>

        <Switch
            android:id="@+id/S_mostrarDatos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginRight="60dp"
            android:onClick="ShowHideData"
            android:text="Mostrar datos numéricos"
            android:textColor="@color/granate"
            android:textSize="20sp" />

        <Switch
            android:id="@+id/S_nombresCons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginRight="60dp"
            android:onClick="ChangeNamesCons"
            android:text="Mostrar nombres en latín"
            android:textColor="@color/granate"
            android:textSize="20sp" />
    </LinearLayout>


</LinearLayout>