<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/negro"
        tools:ignore="UselessParent">

        <LinearLayout
            android:id="@+id/LL_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/IB_Back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignEnd="@+id/Btn_image_old"
                android:layout_alignParentTop="true"
                android:backgroundTint="@color/negro"
                android:onClick="Back"
                app:srcCompat="@drawable/icono_back"
                tools:ignore="ContentDescription,DuplicateIds,ObsoleteLayoutParam"
                app:tint="@color/granate" />

            <TextView
                android:id="@+id/TV_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="false"
                android:layout_below="@+id/LL1"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:text="NGC 6543"
                android:textColor="@color/granate"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText,InefficientWeight,ObsoleteLayoutParam,RtlHardcoded,UnknownIdInLayout" />

            <ImageButton
                android:id="@+id/Btn_edit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignEnd="@+id/Btn_image_old"
                android:layout_alignParentTop="true"
                android:backgroundTint="@android:color/black"
                android:onClick="EditThis"
                app:srcCompat="@drawable/ic_editar"
                tools:ignore="ContentDescription,DuplicateIds,ObsoleteLayoutParam"
                app:tint="@color/granate" />

        </LinearLayout>

        <ScrollView
            android:id="@+id/SV"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/LL_top">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:weightSum="1">

                <ImageView
                    android:id="@+id/IV_foto"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_weight="0.74"
                    android:clickable="true"
                    android:onClick="ShowImage"
                    android:scaleType="center"
                    android:visibility="gone"
                    app:srcCompat="@drawable/imagen"
                    tools:ignore="ContentDescription,InefficientWeight" />

                <Button
                    android:id="@+id/BTN_Name"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="-45dp"
                    android:background="@color/Transparencia"
                    android:gravity="bottom"
                    android:paddingLeft="20dp"
                    android:text="Nebulosa del ojo de gato"
                    android:textAlignment="viewStart"
                    android:textAllCaps="false"
                    android:textColor="@color/granate"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:ignore="HardcodedText,RtlHardcoded,RtlSymmetry" />

                <TextView
                    android:id="@+id/TV_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_below="@+id/TV_id"
                    android:layout_marginLeft="20dp"
                    android:text="Nebulosa del ojo de gato"
                    android:textColor="@color/granate"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:visibility="visible"
                    tools:ignore="HardcodedText,ObsoleteLayoutParam,RtlHardcoded" />

                <TextView
                    android:id="@+id/TV_other"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignBaseline="@+id/TV_id"
                    android:layout_alignBottom="@+id/TV_id"
                    android:layout_alignParentEnd="true"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="10dp"
                    android:text="M 4515 65"
                    android:textColor="@color/gris_oscuro"
                    android:textSize="18sp"
                    tools:ignore="HardcodedText,NotSibling,ObsoleteLayoutParam,RtlHardcoded" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_weight="0.74"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/IB_Map"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_vertical"
                        android:backgroundTint="@color/negro"
                        android:clickable="true"
                        android:cropToPadding="false"
                        android:onClick="openMap"
                        android:scaleX="1.5"
                        android:scaleY="1.5"
                        app:srcCompat="@android:drawable/ic_menu_mylocation"
                        app:tint="@color/Naranja" />

                    <Space
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <RatingBar
                        android:id="@+id/RateBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="false"
                        android:layout_alignParentBottom="false"
                        android:hapticFeedbackEnabled="false"
                        android:numStars="5"
                        android:progressTint="@color/granate"
                        android:rating="2"
                        android:secondaryProgressTint="@color/granate"
                        android:stepSize="1"
                        android:translationY="5dp"
                        tools:ignore="ObsoleteLayoutParam,RtlHardcoded" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_weight="0.74"
                    android:background="@color/negro_sombra"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/textView2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp"
                        android:text="Tipo"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/TV_Tipo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp"
                        android:layout_marginTop="10dp"
                        android:text="Cúmulo"
                        android:textColor="@color/granate"
                        android:textSize="18sp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_weight="0.74"
                    android:background="@color/negro_sombra"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/textView10"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp"
                        android:text="Clasificación"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/TV_Clasif"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp"
                        android:layout_marginTop="10dp"
                        android:text="Abierto"
                        android:textColor="@color/granate"
                        android:textSize="18sp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_weight="0.74"
                    android:background="@color/negro_sombra"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/textView12"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp"
                        android:text="Constelación"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/TV_Constelacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp"
                        android:layout_marginTop="10dp"
                        android:text="Andtromeda"
                        android:textColor="@color/granate"
                        android:textSize="18sp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_weight="0.74"
                    android:background="@color/negro_sombra"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/textView14"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp"
                        android:text="Atlas"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/TV_carta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp"
                        android:layout_marginTop="10dp"
                        android:text="3,72"
                        android:textColor="@android:color/holo_orange_dark"
                        android:textSize="18sp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_weight="0.74"
                    android:background="@color/negro_sombra"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/textView26"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp"
                        android:text="Tamaño aparente"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/TV_Size"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp"
                        android:layout_marginTop="10dp"
                        android:text='22"'
                        android:textColor="@color/granate"
                        android:textSize="18sp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_weight="0.74"
                    android:background="@color/negro_sombra"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/textView18"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp"
                        android:text="Magnitud"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/TV_Magnitud"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp"
                        android:layout_marginTop="10dp"
                        android:text="12"
                        android:textColor="@color/granate"
                        android:textSize="18sp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textView16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginTop="20dp"
                    android:text="Información"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/TV_info"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/border_textvew2"
                    android:padding="10dp"
                    android:text="asdfasf\nasdfasfsa\kdjfd"
                    android:textColor="@color/gris_oscuro"
                    android:textSize="18sp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/textView19"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginTop="20dp"
                    android:text="Memoria de Observación"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/TV_memoria"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/border_textvew2"
                    android:padding="10dp"
                    android:text="asdfasf\nsdsd"
                    android:textColor="@color/gris_oscuro"
                    android:textSize="18sp"
                    tools:ignore="HardcodedText" />

                <Switch
                    android:id="@+id/S_Visto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginTop="20dp"
                    android:checked="false"
                    android:onClick="Add2Viewed"
                    android:text="Añadir a visto"
                    android:textAllCaps="false"
                    android:textColor="@color/granate"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:trackTint="@android:color/white"
                    tools:ignore="HardcodedText" />

                <Switch
                    android:id="@+id/S_Pendiente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginTop="10dp"
                    android:onClick="Add2View"
                    android:text="Pendiente"
                    android:textAllCaps="false"
                    android:textColor="@color/granate"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:trackTint="@android:color/white"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/textView15"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginTop="10dp"
                    android:text="Añadir a lista"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <Spinner
                    android:id="@+id/SP_lista"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/granate"
                    android:popupBackground="@color/negro" />

            </LinearLayout>
        </ScrollView>

    </RelativeLayout>

</LinearLayout>